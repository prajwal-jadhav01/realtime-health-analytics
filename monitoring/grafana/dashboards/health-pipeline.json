{
  "uid": "health-pipeline",
  "title": "Health pipeline: Flink + Pinot",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "flink",
    "pinot"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Flink: records in per second (per task)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_name) (flink_taskmanager_job_task_numRecordsInPerSecond)",
          "legendFormat": "{{task_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pinot: rows ingested per second (per table)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (table) (pinot_server_realtimeRowsFetched_OneMinuteRate)",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Flink: completed checkpoints",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(flink_jobmanager_job_numberOfCompletedCheckpoints)",
          "legendFormat": "completed"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Flink: last checkpoint duration",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(flink_jobmanager_job_lastCheckpointDuration)",
          "legendFormat": "ms"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Flink: job restarts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(flink_jobmanager_job_numRestarts)",
          "legendFormat": "restarts"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Pinot broker: queries per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pinot_broker_queriesGlobal_OneMinuteRate) * 60",
          "legendFormat": "queries/min"
        }
      ]
    }
  ]
}